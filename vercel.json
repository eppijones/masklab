{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/heklomat",
      "destination": "/heklomat/index.html"
    },
    {
      "source": "/heklomat/",
      "destination": "/heklomat/index.html"
    },
    {
      "source": "/((?!system|api/|heklomat/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/system/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/heklomat/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
